{
  "components": {
    "schemas": {
      "AppInstallerDeploymentProcessControls": {
        "properties": {
          "batchFrequencyInMinutes": {
            "description": "Frequency in minutes between deployment batches. Must be between 10 and 1440.",
            "nullable": true,
            "type": "integer"
          },
          "commandsBatchSize": {
            "nullable": true,
            "type": "integer"
          },
          "daysOfWeek": {
            "items": {
              "enum": [
                "MONDAY",
                "TUESDAY",
                "WEDNESDAY",
                "THURSDAY",
                "FRIDAY",
                "SATURDAY",
                "SUNDAY"
              ],
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "fromTimeOfDay": {
            "description": "Start of the daily deployment window in OffsetTime format (e.g. \"08:00:00Z\").",
            "nullable": true,
            "type": "string"
          },
          "toTimeOfDay": {
            "description": "End of the daily deployment window in OffsetTime format (e.g. \"18:00:00Z\").",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "AppInstallerEndUserExperienceSettings": {
        "properties": {
          "completeMessage": {
            "nullable": true,
            "type": "string"
          },
          "deadline": {
            "nullable": true,
            "type": "integer"
          },
          "deadlineMessage": {
            "nullable": true,
            "type": "string"
          },
          "notificationInterval": {
            "nullable": true,
            "type": "integer"
          },
          "notificationMessage": {
            "nullable": true,
            "type": "string"
          },
          "quitDelay": {
            "nullable": true,
            "type": "integer"
          },
          "relaunch": {
            "nullable": true,
            "type": "boolean"
          },
          "suppress": {
            "nullable": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "AppInstallerGlobalSettings": {
        "properties": {
          "deploymentProcessControls": {
            "$ref": "#/components/schemas/AppInstallerDeploymentProcessControls"
          },
          "endUserExperienceSettings": {
            "$ref": "#/components/schemas/AppInstallerEndUserExperienceSettings"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Global settings for App Installer deployments, controlling end-user experience notifications and deployment process controls.",
    "title": "Jamf Pro API - App Installer Global Settings",
    "version": "0.0.1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/v1/app-installers/global-settings": {
      "get": {
        "description": "Retrieves the global settings for App Installer deployments.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerGlobalSettings"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get App Installer global settings",
        "tags": [
          "app-installer-global-settings"
        ],
        "x-required-privileges": [
          "read:pro:mac-applications"
        ],
        "x-required-privileges-legacy": [
          "Read Mac Applications"
        ]
      },
      "put": {
        "description": "Replaces all global settings for App Installer deployments. Fields omitted or null are cleared to their unset state.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppInstallerGlobalSettings"
              }
            }
          },
          "description": "Updated global settings",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerGlobalSettings"
                }
              }
            },
            "description": "Settings updated"
          }
        },
        "summary": "Update App Installer global settings",
        "tags": [
          "app-installer-global-settings"
        ],
        "x-required-privileges": [
          "update:pro:mac-applications"
        ],
        "x-required-privileges-legacy": [
          "Update Mac Applications"
        ]
      }
    }
  }
}
