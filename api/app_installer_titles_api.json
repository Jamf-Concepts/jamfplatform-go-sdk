{
  "components": {
    "schemas": {
      "AppInstallerTitle": {
        "properties": {
          "architecture": {
            "type": "string"
          },
          "availabilityDate": {
            "type": "string"
          },
          "bundleId": {
            "type": "string"
          },
          "iconUrl": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "installerPackageHash": {
            "type": "string"
          },
          "installerPackageHashType": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "launchDaemonIncluded": {
            "type": "boolean"
          },
          "minimumOsVersion": {
            "type": "string"
          },
          "notificationAvailable": {
            "type": "boolean"
          },
          "originalMediaSources": {
            "items": {
              "$ref": "#/components/schemas/OriginalMediaSource"
            },
            "type": "array"
          },
          "packageSigningIdentity": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "shortVersion": {
            "type": "string"
          },
          "sizeInBytes": {
            "type": "integer"
          },
          "suppressAutoUpdate": {
            "type": "boolean"
          },
          "titleName": {
            "description": "Display name of the application",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "AppInstallerTitleSearchResults": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/AppInstallerTitle"
            },
            "type": "array"
          },
          "totalCount": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "OriginalMediaSource": {
        "properties": {
          "hash": {
            "type": "string"
          },
          "hashType": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Browse the Jamf App Catalog of available App Installer titles. Titles are read-only catalog entries provided by Jamf.",
    "title": "Jamf Pro API - App Installer Titles",
    "version": "0.0.1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/v1/app-installers/titles": {
      "get": {
        "description": "Retrieves all available App Installer titles from the Jamf App Catalog with pagination support",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerTitleSearchResults"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get all available App Installer titles",
        "tags": [
          "app-installer-titles"
        ],
        "x-required-privileges": [
          "read:pro:mac-applications"
        ],
        "x-required-privileges-legacy": [
          "Read Mac Applications"
        ]
      }
    },
    "/v1/app-installers/titles/{id}": {
      "get": {
        "description": "Retrieves a specific App Installer title from the catalog",
        "parameters": [
          {
            "description": "ID of the App Installer title",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerTitle"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "description": "Title not found"
          }
        },
        "summary": "Get an App Installer title by ID",
        "tags": [
          "app-installer-titles"
        ],
        "x-required-privileges": [
          "read:pro:mac-applications"
        ],
        "x-required-privileges-legacy": [
          "Read Mac Applications"
        ]
      }
    }
  }
}
