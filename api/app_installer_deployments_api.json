  "info": {
    "description": "Manage App Installer deployment configurations in Jamf Pro. Deployments define which App Installer titles are deployed to which smart groups, along with update behavior and notification settings.",
    "title": "Jamf Pro API - App Installer Deployments",
    "version": "0.0.1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/v1/app-installers/deployments": {
      "get": {
        "description": "Retrieves all App Installer deployment configurations (enabled or not)",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerDeploymentSearchResults"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get all App Installer deployments",
        "tags": [
          "app-installer-deployments"
        ],
        "x-required-privileges": [
          "Read App Installers"
        ]
      },
      "post": {
        "description": "Creates a new App Installer deployment configuration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppInstallerDeploymentCreate"
              }
            }
          },
          "description": "App Installer deployment to create",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerDeploymentRef"
                }
              }
            },
            "description": "Deployment created"
          }
        },
        "summary": "Create an App Installer deployment",
        "tags": [
          "app-installer-deployments"
        ],
        "x-required-privileges": [
          "Create App Installers"
        ]
      }
    },
    "/v1/app-installers/deployments/{id}": {
      "delete": {
        "description": "Deletes an App Installer deployment by ID",
        "parameters": [
          {
            "description": "ID of the deployment",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deployment deleted"
          }
        },
        "summary": "Delete an App Installer deployment",
        "tags": [
          "app-installer-deployments"
        ],
        "x-required-privileges": [
          "Delete App Installers"
        ]
      },
      "get": {
        "description": "Retrieves a specific App Installer deployment by its ID",
        "parameters": [
          {
            "description": "ID of the deployment",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerDeployment"
                }
              }
            },
            "description": "Successful response"
          },
          "404": {
            "description": "Deployment not found"
          }
        },
        "summary": "Get an App Installer deployment by ID",
        "tags": [
          "app-installer-deployments"
        ],
        "x-required-privileges": [
          "Read App Installers"
        ]
      },
      "put": {
        "description": "Updates an existing App Installer deployment configuration",
        "parameters": [
          {
            "description": "ID of the deployment",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppInstallerDeploymentCreate"
              }
            }
          },
          "description": "Updated deployment configuration",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInstallerDeployment"
                }
              }
            },
            "description": "Deployment updated"
          }
        },
        "summary": "Update an App Installer deployment",
        "tags": [
          "app-installer-deployments"
        ],
        "x-required-privileges": [
          "Update App Installers"
        ]
      }
    }
  }
}
