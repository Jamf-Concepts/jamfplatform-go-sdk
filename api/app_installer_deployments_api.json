              "MANUAL"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "appTitleId",
          "deploymentType"
        ],
        "type": "object"
      },
      "AppInstallerDeploymentListItem": {
        "properties": {
          "app": {
            "$ref": "#/components/schemas/AppInstallerApp"
          },
          "category": {
            "$ref": "#/components/schemas/IdName"
          },
          "computerStatuses": {
            "$ref": "#/components/schemas/ComputerStatuses"
          },
          "deploymentType": {
            "enum": [
              "INSTALL_AUTOMATICALLY",
              "SELF_SERVICE"
            ],
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "site": {
            "$ref": "#/components/schemas/IdName"
          },
          "smartGroup": {
