          },
          "categoryId": {
            "type": "string"
          },
          "deploymentType": {
            "enum": [
              "INSTALL_AUTOMATICALLY",
              "SELF_SERVICE"
            ],
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "installPredefinedConfigProfiles": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "notificationSettings": {
            "$ref": "#/components/schemas/NotificationSettings"
          },
          "selfServiceSettings": {
            "$ref": "#/components/schemas/SelfServiceSettings"
          },
          "siteId": {
            "type": "string"
          },
          "smartGroupId": {
