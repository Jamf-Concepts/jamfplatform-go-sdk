          },
          "triggerAdminNotifications": {
            "type": "boolean"
          },
          "updateBehavior": {
            "enum": [
              "AUTOMATIC",
              "MANUAL"
            ],
            "type": "string"
          },
          "versionRemoved": {
            "readOnly": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "AppInstallerDeploymentCreate": {
        "properties": {
          "appTitleId": {
            "description": "ID of the App Installer title to deploy",
