          },
          "id": {
            "readOnly": true,
            "type": "string"
          },
          "installPredefinedConfigProfiles": {
            "type": "boolean"
          },
          "latestAvailableVersion": {
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notificationSettings": {
            "$ref": "#/components/schemas/NotificationSettings"
          },
          "selectedVersion": {
            "type": "string"
          },
          "selfServiceSettings": {
            "$ref": "#/components/schemas/SelfServiceSettings"
          },
          "siteId": {
            "type": "string"
          },
          "smartGroupId": {
            "type": "string"
          },
          "titleAvailableInAis": {
            "readOnly": true,
